PORT=4000
CORS_ORIGIN=*

# "live" streams BTC-USD from Coinbase, "mock" uses a random walk (offline / flat-market demos)
PRICE_MODE=live
ROUND_SECONDS=90
PICK_SECONDS=15

RPC_URL=https://testnet-rpc.monad.xyz
# Leave blank to run without the chain (no registration checks, settlement skipped)
CONTRACT_ADDRESS=0x6F13287544819FfB03638247C7950d0487fE7898
# Must match the referee address passed to the Monarch constructor
REFEREE_PRIVATE_KEY=
